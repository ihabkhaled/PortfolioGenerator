{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,error,global-error,not-found,loading,template,default,sitemap,robots,manifest,opengraph-image}.{ts,tsx}",
    "support/**/*.{mjs,mts}",
    "src/tests/**/*.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "eslint/**/*.mjs", "support/**/*.{mjs,mts}"],
  "ignoreDependencies": ["tailwindcss"],
  "rules": {
    "exports": "off",
    "nsExports": "off",
    "types": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  }
}
