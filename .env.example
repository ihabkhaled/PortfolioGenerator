# ---------------------------------------------------------------------------
# PortfolioGenerate environment. Copy to `.env` and fill in real values.
# Names only — never commit secrets. Every variable is validated once at the
# boundary by src/packages/env; the app refuses to boot on an invalid value.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_APP_ENV=local
NODE_ENV=development
# `next dev`/`next start` are pinned to this via `-p` in package.json; PORT is
# set too so the port is correct even for a bare `next dev` invocation.
PORT=3010

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma at runtime and for migrations.
# One shared local Postgres server on the standard port, holding one database
# per project — the normal shape for a machine with several projects on it.
# `npm run dev` creates this database automatically if it is missing
# (support/ensure-database.mjs); `npm run validate`'s Docker Postgres is a
# separate, isolated instance on port 5433 and is unaffected by this value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_generate
# Local Postgres is plain; production should use verify-full with the provider's
# trusted certificate chain. Never put certificates or credentials in this file.
DATABASE_SSL_MODE=disable

# --- Authentication --------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010
# Production requires this to be true and requires the complete SMTP block.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Admin portal ------------------------------------------------------------
# Separate signing secret for the isolated /managawy auth instance — must not
# equal BETTER_AUTH_SECRET. Generate: openssl rand -base64 48
ADMIN_AUTH_SECRET=
# Bootstrap super-admin account, read once by support/seed-super-admin.mts on
# every `vercel-build`. Safe to leave set after the first deploy — the seed
# is a no-op once an AdminUser with isSuperAdmin=true already exists.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# --- Object storage --------------------------------------------------------
# `local` writes private CVs under .storage/ (development and preview only).
# `s3` targets any S3-compatible endpoint (AWS S3, Cloudflare R2, MinIO).
# Public production requires `s3`; local is the safe default for development.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI provider -----------------------------------------------------------
# `deterministic` is the offline provider used by tests, CI and local dev; it
# never makes a network call. `openai-compatible` targets any OpenAI-shaped
# endpoint (OpenAI, an AI gateway, a self-hosted server).
AI_PROVIDER=deterministic
AI_BASE_URL=
AI_API_KEY=
AI_PRIMARY_MODEL=gpt-5-mini
AI_FALLBACK_MODEL=gpt-5
AI_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT_MS=60000

# --- Translation (Google AI) -----------------------------------------------
# Translating stored portfolio content is configured on its own, independently
# of AI_PROVIDER and AI_API_KEY above. Set AI_GOOGLE_API_KEY and translation
# runs on Google AI whatever the extraction provider is; leave it empty and
# translation is simply unavailable. Gemini is reached through its
# OpenAI-compatible endpoint, so no extra SDK is involved.
AI_GOOGLE_TRANSLATE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_GOOGLE_API_KEY=
AI_TRANSLATION_MODEL=gemini-2.5-flash

# --- Ingestion limits ------------------------------------------------------
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_PAGES=15
EXTRACTION_MAX_INPUT_CHARS=60000
OCR_ENABLED=true

# --- Quotas and budget breaker --------------------------------------------
QUOTA_IMPORTS_PER_USER_PER_DAY=5
QUOTA_AI_OPERATIONS_PER_USER_PER_DAY=20
# Anti-abuse only. Raise it freely while testing; the per-user quotas above
# are what actually price the feature.
QUOTA_UPLOADS_PER_IP_PER_HOUR=100
BUDGET_MAX_AI_OPERATIONS_PER_HOUR=200
BUDGET_MAX_AI_OPERATIONS_PER_DAY=2000

# --- Retention -------------------------------------------------------------
# Days a raw CV is kept after a successful import before scheduled deletion.
RESUME_RETENTION_DAYS=90
# 32+ random bytes. Vercel Cron sends this as an Authorization bearer token.
CRON_SECRET=

# --- Contact ---------------------------------------------------------------
# Disabled is the safe local default. Enabling requires every SMTP value below.
CONTACT_EMAIL_ENABLED=false
CONTACT_EMAIL_PROVIDER=smtp
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=

# --- File security ---------------------------------------------------------
# Off by default so a checkout with no clamd installed still runs. Production
# does not refuse to boot without this — see docs/deployment.md — but running
# it off in production means uploads are stored unscanned; that is a recorded
# launch-readiness risk, not a silent one. When it is on and clamd cannot be
# reached, uploads are refused rather than stored unscanned.
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=20000
CLAMAV_MAX_SIGNATURE_AGE_HOURS=48

# Images are bounded separately from documents: a 6 MB photo is ordinary, a
# 6 MB CV is not.
UPLOAD_IMAGE_MAX_BYTES=6291456

# --- Portfolio PDF download -------------------------------------------------
# Optional. Unset, the PDF cache and the download-token store both fall back
# to an in-process implementation: correct on one instance, but not durable
# across the several instances a real deployment runs. Point this at a real
# Redis (Vercel Marketplace / Upstash in production; `docker compose up redis`
# locally) to get that durability back.
REDIS_URL=
# Escape hatch only. Leave empty: development reuses the Chromium
# `@playwright/test` already installs for the E2E suite, and production loads
# `@sparticuz/chromium`'s bundled build. Set this to point at a Chromium
# binary directly on a deployment target that is neither.
PDF_CHROMIUM_EXECUTABLE_PATH=

# --- PayPal ------------------------------------------------------------------
# Billing: a published portfolio gets a 10-day free trial; after that it is
# deactivated (unpublished, never deleted) until the owner subscribes at
# PAYMENT_PRICE/month, flat, no tiers. Checkout is PayPal's own smart buttons,
# which natively offer both a PayPal account and direct card entry — no
# separate card processor is used.
#
# Blank is disabled, the same as AI_GOOGLE_API_KEY for translation: with none
# of these set the app boots with billing off. Set any one of PAYPAL_CLIENT_ID,
# PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID or NEXT_PUBLIC_PAYPAL_CLIENT_ID and
# all four become required at boot, so a half-entered credential fails loudly
# instead of failing the first real checkout.
#
# PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET: REST API app credentials from
# https://developer.paypal.com/dashboard/applications.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID: the same value as PAYPAL_CLIENT_ID, duplicated
# under a public name because the PayPal JS SDK renders in the browser and
# needs it there. PayPal client ids are not secrets, the same way a Stripe
# publishable key is not — only PAYPAL_CLIENT_SECRET is.
# PAYPAL_ENV: 'sandbox' while testing, 'live' in production.
# PAYPAL_WEBHOOK_ID: NOT a URL. This app's own webhook route
# (/api/payments/webhooks/paypal) is registered as an endpoint in the PayPal
# dashboard; PayPal then issues an opaque webhook id for that registration,
# and that id — not the route path — is what belongs here. It is what PayPal's
# webhook-signature-verification API is called with to prove an inbound event
# actually came from PayPal. See docs/deployment.md for the one-time
# registration step that produces it.
# PAYMENT_PRICE: the amount billed through the PayPal subscription plan.
# NEXT_PAYMENT_PRICE: the amount shown in on-page copy. Despite the NEXT_
# prefix this stays server-only (Next.js only inlines NEXT_PUBLIC_* variables
# into the browser); it is rendered from server components.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
PAYMENT_PRICE=2.50
NEXT_PAYMENT_PRICE=2.50
