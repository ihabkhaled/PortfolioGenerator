# ---------------------------------------------------------------------------
# PortfolioGenerate environment. Copy to `.env` and fill in real values.
# Names only — never commit secrets. Every variable is validated once at the
# boundary by src/packages/env; the app refuses to boot on an invalid value.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local
NODE_ENV=development

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma at runtime and for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_generate

# --- Authentication --------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Object storage --------------------------------------------------------
# `local` writes private CVs under .storage/ (development only).
# `s3` targets any S3-compatible endpoint (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI provider -----------------------------------------------------------
# `deterministic` is the offline provider used by tests, CI and local dev; it
# never makes a network call. `openai-compatible` targets any OpenAI-shaped
# endpoint (OpenAI, an AI gateway, a self-hosted server).
AI_PROVIDER=deterministic
AI_BASE_URL=
AI_API_KEY=
AI_PRIMARY_MODEL=gpt-5-mini
AI_FALLBACK_MODEL=gpt-5
AI_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT_MS=60000

# --- Ingestion limits ------------------------------------------------------
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_PAGES=15
EXTRACTION_MAX_INPUT_CHARS=60000
OCR_ENABLED=false

# --- Quotas and budget breaker --------------------------------------------
QUOTA_IMPORTS_PER_USER_PER_DAY=5
QUOTA_AI_OPERATIONS_PER_USER_PER_DAY=20
QUOTA_UPLOADS_PER_IP_PER_HOUR=20
BUDGET_MAX_AI_OPERATIONS_PER_HOUR=200
BUDGET_MAX_AI_OPERATIONS_PER_DAY=2000

# --- Retention -------------------------------------------------------------
# Days a raw CV is kept after a successful import before scheduled deletion.
RESUME_RETENTION_DAYS=90

# --- Contact -------------------------------------------------------------
# Contact configurations
CONTACT_EMAIL_ENABLED=true
CONTACT_EMAIL_PROVIDER=smtp
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=